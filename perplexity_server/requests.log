      "content": "```src/main/java/com/apexsoft/wsyyt/front/controller/mobile/zsyytController.java\npackage com.apexsoft.wsyyt.front.controller.mobile;\n\nimport com.alibaba.fastjson.JSONObject;\nimport com.apexsoft.front.common.support.BaseFrontController;\nimport com.apexsoft.front.common.utils.SpringUtil;\nimport com.apexsoft.front.common.utils.session.CacheUtil;\nimport com.apexsoft.process.config.BusinessConfig;\nimport com.apexsoft.process.context.RequestParamHolder;\nimport com.apexsoft.process.util.http.HttpClientUtils;\nimport com.apexsoft.wsyyt.common.WsyytConfig;\nimport com.apexsoft.wsyyt.common.menu.MenuEnum;\nimport com.apexsoft.wsyyt.front.service.common.htxy.om.Qsxyxx;\nimport com.apexsoft.wsyyt.front.service.common.khxx.KhxxService;\nimport com.apexsoft.wsyyt.front.service.common.khxx.om.Khxx;\nimport com.apexsoft.wsyyt.front.service.common.yhzh.YhzhService;\nimport com.apexsoft.wsyyt.front.service.common.yhzh.om.Yhzh;\nimport com.apexsoft.wsyyt.front.service.common.zjzh.ZjzhService;\nimport com.apexsoft.wsyyt.front.service.common.zjzh.om.Zjzh;\nimport com.apexsoft.wsyyt.front.service.grxxws.GrxxwsService;\nimport com.apexsoft.wsyyt.front.service.index.BussinessMenuService;\nimport com.apexsoft.wsyyt.front.service.mysql.XybqService;\nimport com.apexsoft.wsyyt.front.service.tydzxy.TydzxyService;\nimport com.apexsoft.wsyyt.front.service.tydzxy.om.XyYwgnEnum;\nimport com.apexsoft.wsyyt.front.service.uep.UepService;\nimport org.apache.commons.lang.BooleanUtils;\nimport org.apache.commons.lang.StringUtils;\nimport org.apache.log4j.Logger;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.beans.factory.annotation.Qualifier;\nimport org.springframework.stereotype.Controller;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.ResponseBody;\n\nimport javax.servlet.http.HttpServletRequest;\nimport javax.servlet.http.HttpServletResponse;\nimport java.io.UnsupportedEncodingException;\nimport java.net.URLEncoder;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\n@Controller(\"zsyytController\")\n@RequestMapping({\"/mobile/zsyyt\"})\npublic class zsyytController extends BaseFrontController {\n\n    @Autowired\n    @Qualifier(\"zjzhService\")\n    private ZjzhService zjzhSvc;\n    \n    @Autowired\n    @Qualifier(\"uepService\")\n    private UepService uepService;\n\n    @Autowired\n    @Qualifier(\"yhzhService\")\n    private YhzhService yhzhSvc;\n\n    @Autowired\n    @Qualifier(\"khxxService\")\n    private KhxxService khxxSvc = null;\n\n    @Autowired\n    @Qualifier(\"bussinessMenuService\")\n    private BussinessMenuService bussinessMenuService;\n\n    @Autowired\n    private GrxxwsService grxxwsService;\n    @Autowired\n    private TydzxyService tydzxyService;\n    @Autowired\n    private XybqService xybqService;\n\n    private static final Logger logger = Logger.getLogger(zsyytController.class);\n\n    @RequestMapping({\"/zsyyt\"})\n    public String queryDcwj(HttpServletRequest request, HttpServletResponse response) throws Exception {\n        Khxx khxx = this.khxxSvc.getKhxxFromSession(request);\n        Zjzh zzjzh = this.zjzhSvc.getZZjzh(khxx.getKhh(), \"1000\");\n        if (zzjzh != null) {\n            List<Yhzh> yhzhList = this.yhzhSvc.getYhzhList(khxx.getKhh(), zzjzh.getZzjzh());\n\n            List<Yhzh> yhzhListWithoutXh = this.yhzhSvc.getYhzhListWithoutXh(yhzhList);\n            if (yhzhListWithoutXh.isEmpty()) {\n                request.setAttribute(\"hadCgyh\", Boolean.FALSE);\n            }\n            else {\n                request.setAttribute(\"hadCgyh\", Boolean.TRUE);\n            }\n        } else {\n            request.setAttribute(\"hadCgyh\", Boolean.FALSE);\n        }\n        String appName = null;\n        Object appName1 = request.getSession().getAttribute(\"appName\");\n        if (appName1 != null){\n            appName = String.valueOf(appName1);\n        }\n        String channel=getChannel(request,\"zsyyt\");\n        // 反洗钱强控、非强控\n        boolean fxqFlag = grxxwsService.checkFxqFlag(khxx.getKhh());\n        Map<String, Object> bigDataFxqComplete = fxqFlag? isYgtFxqComplete(khxx.getKhh(), channel, request, response): new HashMap<>(16);\n        if (BooleanUtils.isFalse((Boolean) bigDataFxqComplete.get(\"isYgtFxqComplete\"))) {\n            request.setAttribute(\"menuJson\", this.bussinessMenuService.getMenuList(\"3\",appName));\n            return bigDataFxqComplete.get(\"jumpUrl\").toString();\n        }\n\n        // 风险测评\n        ifNeedFxpcAgain(khxx.getKhh(), request, response);\n\n        return getDefaultMenu(request, org.apache.commons.lang3.StringUtils.isNoneBlank(appName)?appName:MenuEnum.HBZQ.getChannelCode());\n    }\n\n    @RequestMapping({\"/alert/xyqs\"})\n    public String alertXyqs(HttpServletRequest request, HttpServletResponse response)\n    {\n \t   Khxx khxx = this.khxxSvc.getKhxxFromSession(request);\n \t   List<Qsxyxx> qsxyxxList = new ArrayList<Qsxyxx>();\n \t   String xyId = request.getParameter(\"xyId\");\n \t   String md5 = request.getParameter(\"md5\");\n \t   \n \t   Qsxyxx qsxyxx=new Qsxyxx(xyId, WsyytConfig.GSGM_XYLXDM,md5);\n \t   qsxyxxList.add(qsxyxx);\n \t   \n \t   //这里的ywdm 为空，用协议代码表示，用于定制化协议动态参数\n \t   boolean result=this.uepService.execQsxyByUepV2Dao(khxx,qsxyxxList);\n \t   \n \t   //设置缓存，便于下次直接查询缓存\n \t   CacheUtil.set(WsyytConfig.WSYYT_REDIS_KEY+\"QSGSGMXY_\"+khxx.getKhh(), result, 60*60*24*30);\n \t   //删除已签署协议查询缓存\n \t   CacheUtil.remove(WsyytConfig.WSYYT_REDIS_KEY+\"CXKHQSXY_\"+khxx.getKhh());\n \t   \n \t   printJSON(response, String.valueOf(result));\n \t   return null;\n    }\n    @ResponseBody\n    @RequestMapping({\"/common/xyqs\"})\n    public String commonXyqs(HttpServletRequest request, HttpServletResponse response) throws UnsupportedEncodingException {\n        String customerNo = RequestParamHolder.getKhh();\n        StringBuilder sb = new StringBuilder();\n        String ywgnh = request.getParameter(\"ywgnh\");\n        String url = request.getParameter(\"url\");\n        String businessKey = request.getParameter(\"businessKey\");\n        String yzywlbs = request.getParameter(\"yzywlbs\");\n        String yhjszh = request.getParameter(\"yhjszh\");\n        //移除cache,取配置中值\n        CacheUtil.remove(\"SYSTEM_PARAM_COMMON_XYQS_URI\");\n        String postUrlParm = request.getParameter(\"postUrlParm\");\n        url = URLEncoder.encode(url, \"Utf-8\");\n        if(StringUtils.isEmpty(customerNo) || StringUtils.isEmpty(url) ||StringUtils.isEmpty(businessKey) ||StringUtils.isEmpty(yzywlbs)){\n            throw new IllegalArgumentException(\"Parameters may not be null!\");\n        }\n        StringBuffer postUrl=new StringBuffer(WsyytConfig.getString(postUrlParm));\n        sb.append(\"{\");\n        if(\"10004\".equals(ywgnh)||\"10006\".equals(ywgnh)){\n            sb.append(\"yhjszh:'\"+yhjszh+\"',\");\n        }\n        String khxxStr= khxxSvc.queryKhxx(customerNo);//客户基本信息\n        sb.append(khxxStr);\n        sb.append(\"}\");\n        logger.info(\"dynamics_beforeEncode:\"+sb.toString());\n        String dynamics=URLEncoder.encode(sb.toString(),\"Utf-8\");\n        Map<String, Object> callBackMap = new HashMap<>();\n        postUrl.append(\"?customerNo=\"+customerNo+\"&businessKey=\"+businessKey+\"&yzywlbs=\"+yzywlbs+\"&dynamics=\"+dynamics+\"&url=\"+url);\n        logger.info(postUrl);\n        JSONObject jsonObject = null;\n        try {\n            String post = HttpClientUtils.doPost(postUrl.toString(), null);\n            if (StringUtils.isNotBlank(post)){\n                jsonObject = JSONObject.parseObject(post);\n            }\n        } catch (Exception e) {\n            logger.error(\"请求失败\",e);\n        }\n        logger.info(jsonObject);\n        if(jsonObject!=null && jsonObject.get(\"success\")!=null){\n            String callBackUrl =jsonObject.get(\"result\")==null?\"\": jsonObject.get(\"result\").toString();\n            callBackMap.put(\"callBackUrl\",URLEncoder.encode(callBackUrl,\"Utf-8\"));\n            callBackMap.put(\"success\",jsonObject.get(\"success\"));\n        }else{\n            callBackMap.put(\"callBackUrl\",URLEncoder.encode(\"接口异常\",\"Utf-8\"));\n            callBackMap.put(\"success\",false);\n        }\n        return JSONObject.toJSONString(callBackMap);\n    }\n\n    @RequestMapping({\"/common/xyqs/finish\"})\n    public String commonXyqsFinish(HttpServletRequest request){\n        String ywgnh = RequestParamHolder.getYwgnh();\n        String ywdm = \"\";\n        String name = \"\";\n        Object o = SpringUtil.getBean(ywgnh);\n        if (o instanceof BusinessConfig) {\n            BusinessConfig bean = (BusinessConfig)o;\n            ywdm = bean.getYwdm();\n            name = bean.getName();\n        }else if (o instanceof com.apexsoft.process.extend.config.BusinessConfig) {\n            com.apexsoft.process.extend.config.BusinessConfig bean = (com.apexsoft.process.extend.config.BusinessConfig)o;\n            name = bean.getName();\n            ywdm = tydzxyService.getYwdm(bean);\n            if (org.apache.commons.lang3.StringUtils.isBlank(ywdm)) {\n                ywdm = request.getParameter(\"ywdm\");\n            }\n        }\n        XyYwgnEnum byYwgnh = XyYwgnEnum.getByYwgnh(ywgnh);\n        request.setAttribute(\"khxx\", RequestParamHolder.getKhxx());\n        request.setAttribute(\"ywgnh\",ywgnh);\n        request.setAttribute(\"ywlsh\",RequestParamHolder.getLsh());\n        request.setAttribute(\"ywgnEnName\",name);\n        request.setAttribute(\"ywdm\",ywdm);\n        request.setAttribute(\"isNeedFinish\", byYwgnh != null && byYwgnh.isNeedFinish());\n        request.setAttribute(\"xyqs_nextstep_ywgnh\",WsyytConfig.getString(\"XYQS_NEXTSTEP_YWGNH\"));\n        request.setAttribute(\"openOtherTips\", WsyytConfig.getString(\"HFWJ_OTHERTIPS_YWGNH\").contains(ywgnh));\n        // 协议补签更新数据状态\n        if (request.getParameter(\"xybq\") != null){\n            request.setAttribute(\"xybq\",request.getParameter(\"xybq\"));\n            xybqService.updateByKhhAndYwgnh(RequestParamHolder.getKhh(),ywgnh);\n        }\n        return \"mobile/common/xyqsFinish\";\n    }\n\n    @RequestMapping({\"/common/xyqs/xyqsBack\"})\n    public String xyqsBack(HttpServletRequest request, HttpServletResponse response) throws Exception {\n        String khh = RequestParamHolder.getKhh();\n        String ywgnh = request.getParameter(\"ywgnh\");\n        Object xyqsUrlObj = CacheUtil.get(\"DZXYQS2\"+khh + ywgnh);\n        if(xyqsUrlObj==null){\n            String appName = null;\n            Object appName1 = request.getSession().getAttribute(\"appName\");\n            if (appName1 != null){\n                appName = String.valueOf(appName1);\n            }\n            request.setAttribute(\"menuJson\", this.bussinessMenuService.getMenuList(\"3\",appName));\n            return \"mobile/zsyyt/zsyyt\";\n        }\n        String xyqsUrlStr = xyqsUrlObj.toString();\n        xyqsUrlStr=\"/ppf\"+xyqsUrlStr.split(\"ppf\")[1];\n        logger.info(\"xyqsUrlStr:\"+xyqsUrlStr);\n        request.setAttribute(\"xyqsUrl\", xyqsUrlStr);\n        return \"mobile/common/xyqsBack\";\n    }\n\n    @RequestMapping({\"/thsBack\"})\n    public String thsBack(HttpServletRequest request, HttpServletResponse response) throws Exception {\n        return \"mobile/common/thsBack\";\n    }\n}\n```\n\nzsyytController.java 解释代码",
